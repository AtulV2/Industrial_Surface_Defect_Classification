# .gitignore — Industrial Surface Defect Classification

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/

# Environment variables & secrets
.env
*.env

# Streamlit local settings & secrets
.streamlit/secrets.toml

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Temporary files and logs
*.log
*.tmp
